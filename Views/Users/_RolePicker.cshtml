@model string[]
@using MiniWorkflowEngine.Domain
@{ var roles = ViewData["AvailableRoleNames"] as string[] ?? []; }
<fieldset class="mb-4">
    <legend class="form-label">Roller</legend>
    <p class="small text-muted">En az bir rol seçin. Yönetici rolü kullanıcıları ve erişim yetkilerini yönetebilir.</p>
    <div class="role-options">
        @for (var i = 0; i < roles.Length; i++)
        {
            var role = roles[i];
            <div class="form-check">
                <input type="checkbox" name="Roles" value="@role" checked="@Model.Contains(role)" id="role-@i" class="form-check-input" />
                <label class="form-check-label" for="role-@i">@ApplicationRoles.DisplayName(role)</label>
            </div>
        }
    </div>
    <span class="text-danger small">@Html.ValidationMessage("Roles")</span>
</fieldset>

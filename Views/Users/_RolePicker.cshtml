@model string[]
@using MiniWorkflowEngine.Domain
<fieldset class="mb-4">
    <legend class="form-label">Roller</legend>
    <p class="small text-muted">En az bir rol seçin. Yönetici rolü kullanıcıları ve erişim yetkilerini yönetebilir.</p>
    <div class="role-options">
        @foreach (var role in ApplicationRoles.All)
        {
            <div class="form-check">
                <input type="checkbox" name="Roles" value="@role" checked="@Model.Contains(role)" id="role-@role" class="form-check-input" />
                <label class="form-check-label" for="role-@role">@ApplicationRoles.DisplayName(role)</label>
            </div>
        }
    </div>
    <span class="text-danger small">@Html.ValidationMessage("Roles")</span>
</fieldset>

@model MiniWorkflowEngine.ViewModels.ResetPasswordViewModel
@{ ViewData["Title"] = "Şifre sıfırlama"; }
<section class="surface-card mx-auto my-4" style="max-width: 32rem">
    <a asp-action="Login" class="small text-decoration-none">← Girişe dön</a>
    <h1 class="h3 mt-3">Şifre sıfırlama</h1>
    <p class="text-muted">Kurum yöneticinizden bir kurtarma kodu isteyin. E-posta adresinizi ve aldığınız kodu girerek yeni şifrenizi belirleyin.</p>
    <form asp-action="ResetPassword" method="post">
        <div asp-validation-summary="All" class="text-danger validation-summary" role="alert"></div>
        <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="username" /></div>
        <div class="mb-3"><label asp-for="Code" class="form-label"></label><input id="Code" name="Code" type="password" class="form-control" autocomplete="off" required maxlength="2048" /></div>
        <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /></div>
        <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /></div>
        <button class="btn btn-primary">Şifreyi güncelle</button>
    </form>
</section>

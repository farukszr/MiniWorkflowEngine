@model MiniWorkflowEngine.ViewModels.WorkflowListViewModel
@using MiniWorkflowEngine.ViewModels
@{
    ViewData["Title"] = "Süreç tanımları";
    var filters = new[] { (WorkflowListState.All, "Tümü"), (WorkflowListState.Active, "Etkin"),
        (WorkflowListState.Draft, "Taslak"), (WorkflowListState.Archived, "Arşiv") };
}
<section class="my-4">
    <div class="page-heading">
        <div><span class="eyebrow">Süreç tasarımı</span><h1 class="h2 mt-2">Süreç tanımları</h1><p class="text-muted mb-0">Bir akış tasarla, örnek değerlerle dene ve kullanıma aç.</p></div>
        <a class="btn btn-primary" asp-action="Designer">+ Yeni akış tasarla</a>
    </div>
    <div class="d-flex flex-wrap gap-3 mt-3 small">
        <a asp-action="Designer" asp-route-ornek="masraf">10.000 TL masraf örneğini aç</a>
        <details><summary>Diğer oluşturma seçenekleri</summary><a asp-action="Create">Sıralı süreç oluştur</a></details>
    </div>
    <div class="surface-card mt-4">
        <nav class="process-filters mb-3" aria-label="Süreç durumuna göre filtrele">
            @foreach (var (state, label) in filters)
            {
                <a asp-action="Index" asp-route-state="@state" asp-route-search="@Model.Search" aria-current="@(state == Model.State ? "page" : null)">@label</a>
            }
        </nav>
        <form method="get" class="directory-search" role="search"><input type="hidden" name="state" value="@Model.State" /><div class="flex-grow-1"><label for="search" class="form-label">Süreç kodu veya adı</label><input class="form-control" id="search" name="search" value="@Model.Search" maxlength="100" placeholder="Süreç ara…" /></div><button class="btn btn-outline-primary">Ara</button><a asp-action="Index" asp-route-state="@Model.State" class="btn btn-link">Aramayı temizle</a></form>
        <p class="small text-muted mt-3">@Model.TotalCount sürüm · Sayfa @Model.Page / @Model.TotalPages</p>
        @if (Model.Items.Count == 0) { <div class="empty-state"><h2 class="h5">Süreç bulunamadı</h2><p class="text-muted">Yeni bir süreç oluşturarak başlayın veya aramanızı değiştirin.</p></div> }
        else
        {
            <div class="table-responsive"><table class="table align-middle user-table"><caption class="visually-hidden">Süreçler ve sürümleri</caption><thead><tr><th>Süreç</th><th>Sürüm</th><th>Tür</th><th>Durum</th><th><span class="visually-hidden">İşlem</span></th></tr></thead><tbody>
            @foreach (var item in Model.Items)
            {
                <tr><td><a class="fw-semibold text-decoration-none" asp-action="Details" asp-route-id="@item.Id">@item.Name</a><span class="d-block small text-muted">@item.Code</span></td><td>v@(item.Version)</td><td>@(item.IsGraph ? "Görsel" : "Sıralı")</td><td><span class="request-status @(item.IsActive ? "status-approved" : item.IsPublished ? "status-neutral" : "status-pending")">@(item.IsActive ? "Etkin" : item.IsPublished ? "Arşiv" : "Taslak")</span></td><td class="text-end">
                    @if (item.IsGraph && !item.IsPublished) { <a class="btn btn-outline-primary btn-sm" asp-action="Designer" asp-route-id="@item.Id">Tasarla</a> }
                    <a class="btn btn-outline-secondary btn-sm" asp-action="Details" asp-route-id="@item.Id">İncele</a>
                </td></tr>
            }
            </tbody></table></div>
            @if (Model.TotalPages > 1)
            {
                <nav class="d-flex justify-content-between mt-3" aria-label="Süreç sayfaları">
                    @if (Model.Page > 1) { <a class="btn btn-outline-secondary btn-sm" asp-route-state="@Model.State" asp-route-search="@Model.Search" asp-route-page="@(Model.Page - 1)">← Önceki</a> } else { <span></span> }
                    @if (Model.Page < Model.TotalPages) { <a class="btn btn-outline-secondary btn-sm" asp-route-state="@Model.State" asp-route-search="@Model.Search" asp-route-page="@(Model.Page + 1)">Sonraki →</a> }
                </nav>
            }
        }
    </div>
</section>

